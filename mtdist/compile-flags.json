{
  "note": "Substitute ${SYSROOT} and ${RESOURCE} with the guest paths the release sysroot/ and resource/lib/clang/<ver> dirs are mounted at. Required on hosts whose preopens cannot readdir.",
  "clangResourceVersion": "24",
  "compile": {
    "wasm32-wasip1": [
      "--target=wasm32-unknown-wasip1",
      "--sysroot=${SYSROOT}",
      "-resource-dir=${RESOURCE}",
      "-isystem${SYSROOT}/include/wasm32-wasip1/eh/c++/v1",
      "-isystem${SYSROOT}/include/c++/v1",
      "-fwasm-exceptions"
    ],
    "wasm32-wasip1-threads": [
      "--target=wasm32-unknown-wasip1-threads",
      "--sysroot=${SYSROOT}",
      "-resource-dir=${RESOURCE}",
      "-isystem${SYSROOT}/include/wasm32-wasip1-threads/eh/c++/v1",
      "-isystem${SYSROOT}/include/c++/v1",
      "-fwasm-exceptions",
      "-pthread"
    ]
  },
  "link": {
    "wasm32-wasip1": [
      "${SYSROOT}/lib/wasm32-wasip1/crt1.o",
      "-L${SYSROOT}/lib/wasm32-wasip1/eh",
      "-L${SYSROOT}/lib/wasm32-wasip1",
      "-mllvm",
      "-wasm-enable-eh",
      "-mllvm",
      "-exception-model=wasm",
      "-lc++",
      "-lc++abi",
      "-lunwind",
      "-lc",
      "${RESOURCE}/lib/wasm32-unknown-wasip1/libclang_rt.builtins.a"
    ],
    "wasm32-wasip1-threads": [
      "${SYSROOT}/lib/wasm32-wasip1-threads/crt1.o",
      "-L${SYSROOT}/lib/wasm32-wasip1-threads/eh",
      "-L${SYSROOT}/lib/wasm32-wasip1-threads",
      "--import-memory",
      "--shared-memory",
      "--max-memory=2147483648",
      "-mllvm",
      "-wasm-enable-eh",
      "-mllvm",
      "-exception-model=wasm",
      "-lc++",
      "-lc++abi",
      "-lunwind",
      "-lc",
      "${RESOURCE}/lib/wasm32-unknown-wasip1-threads/libclang_rt.builtins.a"
    ]
  },
  "pch": {
    "wasm32-wasip1": {
      "defaultStd": "gnu++17",
      "variants": [
        {
          "file": "pch-gnupp17.pch",
          "std": "gnu++17",
          "optimization": "0"
        },
        {
          "file": "pch-gnupp17-O2.pch",
          "std": "gnu++17",
          "optimization": "2"
        },
        {
          "file": "pch-cpp17.pch",
          "std": "c++17",
          "optimization": "0"
        },
        {
          "file": "pch-cpp17-O2.pch",
          "std": "c++17",
          "optimization": "2"
        },
        {
          "file": "pch-gnupp20.pch",
          "std": "gnu++20",
          "optimization": "0"
        },
        {
          "file": "pch-gnupp20-O2.pch",
          "std": "gnu++20",
          "optimization": "2"
        },
        {
          "file": "pch-cpp20.pch",
          "std": "c++20",
          "optimization": "0"
        },
        {
          "file": "pch-cpp20-O2.pch",
          "std": "c++20",
          "optimization": "2"
        }
      ]
    },
    "wasm32-wasip1-threads": {
      "defaultStd": "gnu++17",
      "variants": [
        {
          "file": "pch-gnupp17-threads.pch",
          "std": "gnu++17",
          "optimization": "0"
        },
        {
          "file": "pch-gnupp17-O2-threads.pch",
          "std": "gnu++17",
          "optimization": "2"
        },
        {
          "file": "pch-cpp17-threads.pch",
          "std": "c++17",
          "optimization": "0"
        },
        {
          "file": "pch-cpp17-O2-threads.pch",
          "std": "c++17",
          "optimization": "2"
        },
        {
          "file": "pch-gnupp20-threads.pch",
          "std": "gnu++20",
          "optimization": "0"
        },
        {
          "file": "pch-gnupp20-O2-threads.pch",
          "std": "gnu++20",
          "optimization": "2"
        },
        {
          "file": "pch-cpp20-threads.pch",
          "std": "c++20",
          "optimization": "0"
        },
        {
          "file": "pch-cpp20-O2-threads.pch",
          "std": "c++20",
          "optimization": "2"
        }
      ]
    }
  }
}